# Configuración de PostHog Analytics
# Reemplaza <TU_POSTHOG_API_KEY> con la clave de proyecto de tu panel de PostHog (Settings -> Project API Key)
NEXT_PUBLIC_POSTHOG_KEY="tu_clave_api_de_posthog_aqui"

# Usa https://us.i.posthog.com para proyectos en EE.UU. o https://eu.i.posthog.com para la región de Europa
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
